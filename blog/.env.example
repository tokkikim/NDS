# 배포 도메인 (sitemap, RSS, 썸네일, canonical URL에 사용)
# 무료 주소 예: https://my-study-blog.pages.dev
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# 애드센스 (승인 후 입력, 비워두면 광고 코드가 들어가지 않습니다)
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# 네이버 검색광고 API (월간 검색량·경쟁도·입찰가) - searchad.naver.com → 도구 → API 사용 관리
NAVER_AD_API_KEY=
NAVER_AD_SECRET=
NAVER_AD_CUSTOMER_ID=

# 네이버 데이터랩 (검색 추세) - developers.naver.com → 애플리케이션 등록 → 데이터랩(검색어트렌드)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
